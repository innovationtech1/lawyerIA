# Copie estas variables en Vercel: Project → Settings → Environment Variables.
# Nunca suba al repositorio un archivo .env con claves reales.

# --- IA gratuita (predeterminada): Groq con un modelo de código abierto ---
# Clave gratis en console.groq.com → API Keys (empieza con gsk_)
GROQ_API_KEY=
# Opcional: modelo (por defecto openai/gpt-oss-120b) y esfuerzo de razonamiento (low, medium, high)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium

# --- Opcional: Claude (de pago, más preciso) ---
# Para usarlo, ponga AI_PROVIDER=anthropic y la clave de console.anthropic.com (sk-ant-api03-...)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Datos del despacho que verá el usuario y que usa la IA ---
FIRM_NAME=Despacho de Inmigración Ejemplo
ATTORNEY_NAME=Lic. Nombre Apellido
FIRM_PHONE=+1 (210) 555-0100
FIRM_WHATSAPP=12105550100
FIRM_EMAIL=contacto@ejemplo.com
